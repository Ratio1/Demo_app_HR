{
  "name": "demo-app-hr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/cli-esm-finalize.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:unit:tz": "TZ=UTC vitest run --project unit && TZ=Pacific/Kiritimati vitest run --project unit && TZ=Pacific/Niue vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
