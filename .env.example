# Demo_App_HR — the complete list of application environment variables (spec §4).
#
# There is no DATABASE_URL, no session/signing secret, no APP_URL and no PORT: the public
# origin lives in the database (`manage set-origin`) and the container port is fixed.
# Never commit a filled-in copy of this file; `.env` and `.env*.local` are git-ignored.
#
# Maintenance (migrations, bootstrap, user management) runs once, outside serving, with the
# owner role. Serving uses the DML-only runtime role. Both use these same variable names.

# Database endpoint as host or host:port. Bracket IPv6 literals: [::1] or [::1]:5432.
# No URL, no query string, no TLS options. From inside the container the shared dev server
# is reachable as host.docker.internal:5432.
DB_SERVER=host.docker.internal:5432

# Optional port override, 1-65535, default 5432. Leave it unset when DB_SERVER already
# carries a port; setting both to different values is refused at startup.
#DB_PORT=5432

# Runtime role for serving (…_app) or owner role for maintenance (…_owner).
DB_USER=hr_app

# Never logged, never echoed, never passed as a command-line argument.
DB_PASSWORD=

# Existing, dedicated application database.
DB_NAME=hr
